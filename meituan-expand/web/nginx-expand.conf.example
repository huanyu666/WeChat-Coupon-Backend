# Copy to /etc/nginx/sites-available/mt-expand
# Then: ln -s /etc/nginx/sites-available/mt-expand /etc/nginx/sites-enabled/
# htpasswd: htpasswd -c /etc/nginx/.htpasswd_mt expand

server {
    listen 443 ssl http2;
    server_name expand.example.com;

    # ssl_certificate     /etc/letsencrypt/live/expand.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/expand.example.com/privkey.pem;

    auth_basic "Expand Console";
    auth_basic_user_file /etc/nginx/.htpasswd_mt;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name expand.example.com;
    return 301 https://$host$request_uri;
}
