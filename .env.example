WX_SERVICE_ROOT=/opt/wx-service/current
WX_SERVICE_ENV=prod
WX_SERVICE_DEPLOYMENT_NAME=wx-coupon-prod
WX_SERVICE_DATA_DIR=/var/lib/wx-service
WX_SERVICE_CONFIG_FILE=
WX_SERVICE_RUNTIME_DIR=/run/wx_service-python
WX_SERVICE_LOG_DIR=/var/log/wx-service
WX_SERVICE_SOCKET_PATH=/run/wx_service-python/wx_service.sock
WX_SERVICE_AUTO_START_GO=false
GO_INTERNAL_API_SOCKET_PATH=/run/wx_service/meituan-query-internal.sock
GO_SHORTLINK_PUBLIC_BASE_URL=https://jd2.top
WX_SERVICE_REDIS_SOCKET_PATH=/run/redis/redis-server.sock
WX_SERVICE_REDIS_URL=
WX_SERVICE_REDIS_HOST=
WX_SERVICE_REDIS_PORT=6379
WX_SERVICE_REDIS_PASSWORD=
WX_SERVICE_REDIS_DB=0
WX_SERVICE_REDIS_SOCKET_TIMEOUT_SECONDS=1.5
WX_SERVICE_REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
WX_PROXY_API_URL=
WX_ORDER_RANKINGS_LINK_SECRET=
WX_LOGIN_FAILURE_WINDOW_SECONDS=900
WX_LOGIN_FAILURE_MAX_ATTEMPTS=8
WX_LOGIN_LOCK_SECONDS=900
WX_WECHAT_MAX_BODY_BYTES=262144
WX_SMOKE_BASE_URL=http://127.0.0.1
WX_SMOKE_TIMEOUT_SECONDS=3
WX_SMOKE_ALLOW_GO_DEGRADED=false
WX_SMOKE_ALLOW_REDIS_UNREACHABLE=false
WX_SMOKE_ADMIN_USERNAME=
WX_SMOKE_ADMIN_PASSWORD=
WX_SMOKE_WECHAT_TOKEN=
WX_SMOKE_WECHAT_ACCOUNT_ID=
