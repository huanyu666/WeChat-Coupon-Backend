[Unit]
Description=WorkBuddy Skill Admin Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/skill
EnvironmentFile=/www/wwwroot/skill/.env
ExecStart=/usr/bin/node /www/wwwroot/skill/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/www/wwwroot/skill/config /www/wwwroot/skill/data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
